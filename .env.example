# Copy this file to .env and fill in real values. Never commit .env.

# --- Trading mode ---
# PAPER=true ALWAYS for this bot. core.config.assert_paper_mode() refuses
# to start otherwise.
PAPER=true
DRY_RUN=true

# --- Dashboard bind address ---
# Read by docker compose, the Dockerfile CMD and the systemd unit.
# Supported values: 127.0.0.1 (default, loopback only) and 0.0.0.0 (not
# recommended: the dashboard has no authentication).
DASHBOARD_HOST=127.0.0.1

# --- Client Portal Gateway (CPGW) connection ---
# Phase 7+ talks to the IBKR Client Portal Gateway (CPGW).
# Default port is 5000; no other port is allowed by assert_paper_mode.
IB_HOST=localhost
IB_PORT=5000
IB_CLIENT_ID=0

# --- Gateway login and TLS ---
# The IBKR username and password are NOT stored here. They live in the file
# secrets/ibkr_login (mode 600), mounted into cpgw_keeper as a Compose secret.
# Leave this empty in Docker (the default is /run/secrets/ibkr_login). Set it
# only to run the keeper outside Docker.
IBKR_LOGIN_SECRET_FILE=
# Path to the gateway certificate, as seen inside the containers. Empty by
# default (TLS is not verified for the portfolio runner, and the keeper login
# refuses to run). With the ibkr_gateway container set:
#   CPGW_CA_FILE=/app/gateway_tls/cert.pem
# With the host Java gateway, export its certificate once (deploy/README.md).
CPGW_CA_FILE=

# --- Telegram alerts (optional) ---
# Bot token from @BotFather and the chat id that receives the alerts.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Email notifications (Gmail SMTP) ---
# Generate an App Password at https://myaccount.google.com/apppasswords
EMAIL_USER=your_address@gmail.com
EMAIL_PASS=your_16_char_app_password
EMAIL_RECIPIENTS=your_address@gmail.com

# --- Sentiment provider (Phase 6) ---
# Free key at https://www.alphavantage.co/support/#api-key
# Only needed when `sentiment.provider: alpha_vantage` in config/symbols.yaml.
# Use the `stub` provider (no key needed) when testing.
ALPHA_VANTAGE_API_KEY=
# Overrides `provider` in the sentiment_provider block of config/symbols.yaml.
# Allowed: stub, alpha_vantage. Empty means the YAML value is used.
SENTIMENT_PROVIDER=
