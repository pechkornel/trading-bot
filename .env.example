# Copy this file to .env and fill in real values. Never commit .env.

# --- Trading mode ---
# PAPER=true ALWAYS for this bot. core.config.assert_paper_mode() refuses
# to start otherwise.
PAPER=true
DRY_RUN=true

# --- Client Portal Gateway (CPGW) connection ---
# Phase 7+ talks to the IBKR Client Portal Gateway (CPGW).
# Default port is 5000; no other port is allowed by assert_paper_mode.
IB_HOST=localhost
IB_PORT=5000
IB_CLIENT_ID=0

# --- IBKR credentials (used by live/cpgw_keeper.py) ---
# The keeper runs the SRP-6a login on startup and re-logs when the session
# drops. Password never leaves this file or the local process — it never goes
# over the wire (that's the point of SRP).
# chmod 600 .env, and treat the file as a secret.
IBKR_USERNAME=
IBKR_PASSWORD=

# --- Email notifications (Gmail SMTP) ---
# Generate an App Password at https://myaccount.google.com/apppasswords
EMAIL_USER=your_address@gmail.com
EMAIL_PASS=your_16_char_app_password
EMAIL_RECIPIENTS=your_address@gmail.com

# --- Sentiment provider (Phase 6) ---
# Free key at https://www.alphavantage.co/support/#api-key
# Only needed when `sentiment.provider: alpha_vantage` in config/symbols.yaml.
# Use the `stub` provider (no key needed) when testing.
ALPHA_VANTAGE_API_KEY=
