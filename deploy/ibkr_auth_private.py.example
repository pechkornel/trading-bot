"""Template for core/ibkr_auth_private.py (git-ignored, never commit the real file).

Copy it to core/ibkr_auth_private.py. It is wiring only: the login flow itself is the
tracked, tested module core/gateway_login.py. Credentials come from secrets/ibkr_login
through core.secret_store, never from this file.

Selectors and success markers can be overridden here after you confirm them against the
real login page on the server, for example:

    GatewayLoginConfig.from_env() then dataclasses.replace(cfg, username_selector="...")
"""

from core.gateway_login import GatewayLoginConfig, login_via_gateway_page


def login(creds, *, port, **kwargs):
    return login_via_gateway_page(
        creds,
        port=port,
        config=GatewayLoginConfig.from_env(),
        on_submit=kwargs.get("on_submit"),
    )
