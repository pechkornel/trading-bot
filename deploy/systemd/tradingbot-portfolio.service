[Unit]
Description=Trading bot portfolio runner (multi-symbol)
After=network-online.target tradingbot-dashboard@%i.service tradingbot-cpgw-keeper@%i.service
Wants=network-online.target tradingbot-cpgw-keeper@%i.service

[Service]
Type=exec
User=%i
WorkingDirectory=/opt/trading-bot
EnvironmentFile=/opt/trading-bot/.env
# Default: dry-run. To go live, change to: --live
ExecStart=/opt/trading-bot/.venv/bin/python -m live.portfolio_runner
Restart=on-failure
RestartSec=10
LimitNOFILE=8192

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=-/opt/trading-bot/logs -/opt/trading-bot/models/artifacts

[Install]
WantedBy=default.target
