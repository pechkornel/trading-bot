[Unit]
Description=Trading bot CPGW session keeper (SRP login + /tickle keepalive)
After=network-online.target tradingbot-dashboard@%i.service
Wants=network-online.target

[Service]
Type=exec
User=%i
WorkingDirectory=/opt/trading-bot
EnvironmentFile=/opt/trading-bot/.env
# Needs IBKR_USERNAME / IBKR_PASSWORD. Refuses to start without them.
ExecStart=/opt/trading-bot/.venv/bin/python -m live.cpgw_keeper
Restart=on-failure
RestartSec=10
LimitNOFILE=8192

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=-/opt/trading-bot/logs

[Install]
WantedBy=default.target
