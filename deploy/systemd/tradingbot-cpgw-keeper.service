[Unit]
Description=Trading bot CPGW session keeper (SRP login + /tickle keepalive)
After=network-online.target tradingbot-dashboard@%i.service
Wants=network-online.target

[Service]
Type=exec
User=%i
WorkingDirectory=/opt/trading-bot
EnvironmentFile=/opt/trading-bot/.env
# The login is the file below (chmod 600, owned by the service user), never .env.
# CPGW_CA_FILE (the gateway certificate for the browser pin) comes from .env.
Environment=IBKR_LOGIN_SECRET_FILE=/opt/trading-bot/secrets/ibkr_login
ExecStart=/opt/trading-bot/.venv/bin/python -m live.cpgw_keeper
Restart=on-failure
RestartSec=10
LimitNOFILE=8192

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=-/opt/trading-bot/logs

[Install]
WantedBy=default.target
