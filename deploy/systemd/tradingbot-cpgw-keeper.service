[Unit]
Description=Trading bot CPGW session keeper (SRP login + /tickle keepalive)
After=network-online.target tradingbot-dashboard.service
Wants=network-online.target

[Service]
Type=exec
User=%i
WorkingDirectory=/home/%i/trading-bot/bot
EnvironmentFile=/home/%i/trading-bot/bot/.env
# Needs IBKR_USERNAME / IBKR_PASSWORD. Refuses to start without them.
ExecStart=/home/%i/trading-bot/bot/.venv/bin/python -m live.cpgw_keeper
Restart=on-failure
RestartSec=10
LimitNOFILE=8192

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/%i/trading-bot/bot/logs

[Install]
WantedBy=default.target
