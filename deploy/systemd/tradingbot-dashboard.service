[Unit]
Description=Trading bot dashboard (FastAPI)
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=%i
# Assumes the repo is cloned at /opt/trading-bot. Edit every path below if not.
WorkingDirectory=/opt/trading-bot
EnvironmentFile=/opt/trading-bot/.env
ExecStart=/opt/trading-bot/.venv/bin/uvicorn dashboard.app:app --host 127.0.0.1 --port 8765
Restart=on-failure
RestartSec=5
# Block live ports at the firewall level too — paper-only deployment
LimitNOFILE=8192

# Hardening (safe defaults for a home server)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=-/opt/trading-bot/logs -/opt/trading-bot/models/artifacts

[Install]
WantedBy=default.target
